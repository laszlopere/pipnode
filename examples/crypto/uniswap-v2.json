  {
   "type": "PnExpression2",
   "uuid": "4d930e68-c0ff-4cb1-bb95-90590ad6e9fa",
   "name": "AMM · this swap",
   "worksheet": "Worksheet",
   "position": {
    "x": 500.0,
    "y": 490.0
   },
   "properties": {
    "inputs": 4,
    "expression": "dx = x * pct / 100\ny = x * p0\nf = 1 - fee / 10000\ndxf = dx * f\ndy = dxf * y / (x + dxf)\nexec = f * y / (x + dxf)\nimpact = (1 - exec / p0) * 100\nx2 = x + dx\ny2 = y - dy\nnewmid = y2 / x2\nlpfee = dx * (fee / 10000) * p0\nk0 = x * y\nk1 = x2 * y2\nkgrow = (k1 / k0 - 1) * 100\ndxs = floor(dx * 10 + 0.5) / 10\npcts = floor(pct * 10 + 0.5) / 10\ndyk = floor(dy / 100 + 0.5) / 10\npxs = floor(exec * 100 + 0.5) / 100\nimps = floor(impact * 100 + 0.5) / 100\nmids = floor(newmid * 100 + 0.5) / 100\ndy"
   },
   "input-names": {
    "0": "x",
    "1": "p0",
    "2": "pct",
    "3": "fee"
   }
  },
  {
   "type": "PnExpression2",
   "uuid": "a87a0398-b26d-4e17-ad55-1042451fe17a",
   "name": "AMM · sweep curve",
   "worksheet": "Worksheet",
   "position": {
    "x": 500.0,
    "y": 1010.0
   },
   "properties": {
    "inputs": 4,
    "expression": "y = x * p0\nf = 1 - fee / 10000\ndf = d * f\nxv = x + d\nyv = y - (df * y / (x + df))\nex = f * y / (x + df)\nimp = (1 - ex / p0) * 100\nxn = xv / x\nyn = yv / y\nimp"
   },
   "input-names": {
    "0": "d",
    "1": "x",
    "2": "p0",
    "3": "fee"
   }
  },

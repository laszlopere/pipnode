    {
      "type": "PnComment",
      "uuid": "22edd21a-7e1e-4877-b157-f7515aad4ae8",
      "name": "Comment 1",
      "worksheet": "Worksheet",
      "position": {
        "x": 100.0,
        "y": 40.0
      },
      "properties": {
        "text": "A burglar alarm panel.  Type 1234 on the keypad and press # to arm -- the LCD counts the exit delay down, then reads ARMED.  Flip a Switch to open a zone: the front door starts the entry delay (type 1234 # again to disarm in time), any other zone sounds the siren at once.  The panel names the zone that tripped it, and the zone names ARE the Burglar Alarm's input names -- rename an input on its Inputs tab and every announcement follows.",
        "width": 1000.0,
        "height": 76.0,
        "text-size": 13.0,
        "background-color": "rgb(255,255,255)",
        "frame-color": "rgb(158,158,158)",
        "text-color": "rgb(46,51,59)"
      }
    },

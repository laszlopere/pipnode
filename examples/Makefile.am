# Example worksheets.  Installed under $(pkgdatadir)/examples/, grouped
# into one sub-directory per category so the bundled samples land in a
# public, browsable location (e.g. /usr/local/share/pipnode/examples/)
# alongside the help pages and node icons shipped from data/.

imagedir = $(pkgdatadir)/examples/image
image_DATA = \
	image/bloom-glow.json \
	image/canny-edges.json \
	image/cartoonize.json \
	image/image-blend.json \
	image/image-processing.json \
	image/image-test.json \
	image/pencil-sketch.json

networkingdir = $(pkgdatadir)/examples/networking
networking_DATA = \
	networking/crypto-price.json \
	networking/http-collecting.json \
	networking/https-tunnel.json \
	networking/network_test.json \
	networking/weather.json

cryptodir = $(pkgdatadir)/examples/crypto
crypto_DATA = \
	crypto/bridge-comparison.json \
	crypto/crypto-monitor.json \
	crypto/exchange-monitor.json \
	crypto/exchange-rates.json

homeautomationdir = $(pkgdatadir)/examples/home-automation
homeautomation_DATA = \
	home-automation/mqtt-test.json \
	home-automation/power.json \
	home-automation/power-meters.json \
	home-automation/staircase.json \
	home-automation/tasmota-concentrator.json \
	home-automation/tasmota-discovery.json \
	home-automation/tasmota-socket.json \
	home-automation/tasmota-switch.json

systemmonitoringdir = $(pkgdatadir)/examples/system-monitoring
systemmonitoring_DATA = \
	system-monitoring/3d-graphs.json \
	system-monitoring/command-parsers.json \
	system-monitoring/host_compare.json \
	system-monitoring/host_load.json \
	system-monitoring/shell.json \
	system-monitoring/tmux-example.json

speechandsounddir = $(pkgdatadir)/examples/speech-and-sound
speechandsound_DATA = \
	speech-and-sound/ollama-test.json \
	speech-and-sound/sound-effects.json \
	speech-and-sound/tts-test.json

controlsandlogicdir = $(pkgdatadir)/examples/controls-and-logic
controlsandlogic_DATA = \
	controls-and-logic/animation-test.json \
	controls-and-logic/comparator-test.json \
	controls-and-logic/filter-examples.json \
	controls-and-logic/jumps.json \
	controls-and-logic/knob.json \
	controls-and-logic/notify-test.json \
	controls-and-logic/toy-cpu-accumulator.json

timedir = $(pkgdatadir)/examples/time
time_DATA = \
	time/time-left.json

displaysdir = $(pkgdatadir)/examples/displays
displays_DATA = \
	displays/LED-displays.json

miscdir = $(pkgdatadir)/examples/misc
misc_DATA = \
	misc/untitled.json

EXTRA_DIST = \
	$(image_DATA) \
	$(networking_DATA) \
	$(crypto_DATA) \
	$(homeautomation_DATA) \
	$(systemmonitoring_DATA) \
	$(speechandsound_DATA) \
	$(controlsandlogic_DATA) \
	$(time_DATA) \
	$(displays_DATA) \
	$(misc_DATA)
